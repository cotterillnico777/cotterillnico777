# Kopieren nach .env und ausfüllen. .env wird NICHT committet.
# API-Schlüssel nur mit Handelsrecht anlegen, OHNE Auszahlungsrecht (Withdrawals).
TRADING_BOT_API_KEY=
TRADING_BOT_API_SECRET=
# Nur für Börsen, die ein Passwort/Passphrase verlangen (z. B. KuCoin, OKX)
TRADING_BOT_API_PASSWORD=

# --- quantbot (v2, Futures) ---
# Betriebsmodus: backtest | paper | live  (Standard: paper). LIVE braucht zusätzlich
# live.enabled: true in der Konfiguration UND die Bestätigung unten.
TRADING_MODE=paper
# Nur für LIVE, exakt dieser Wert: I_ACCEPT_REAL_MONEY_RISK
QUANTBOT_LIVE_CONFIRM=
# API-Schlüssel NUR mit Trading-Recht, OHNE Auszahlungsrecht. Für Marktdaten nicht nötig.
QUANTBOT_API_KEY=
QUANTBOT_API_SECRET=
QUANTBOT_API_PASSWORD=
